/build
/build-*
/install
/install-*
/.cache
/.vscode
/.idea
/.reasonix
# Local DSH harness state (skills/caches); not part of the engine or its build.
/.dsh
/CMakeUserPresets.json
/conan.lock

# Python bytecode caches (tools/*.py)
__pycache__/
*.pyc

# Game files and local run directories (never committed)
*.jar
*.mca
*.mcr
*.dat
*.nbt
*.log
/run/

# Benchmark output is regenerated per machine and never committed.
/bench/results/

# The world generation datapack is generated from the user's own server.jar by
# scripts/fetch-content.sh and is never committed; see content/vanilla/NOTICE.md.
content/vanilla/*/data
content/vanilla/*/MANIFEST.json

# Machine-local agent guidance; names absolute paths and is never published.
/AGENTS.local.md
# Per-lane git worktrees used for parallel work; machine-local by definition.
/.agents/
