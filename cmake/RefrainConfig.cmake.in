#
# CMake package config for the installed Refrain SDK.
#
# The exported target `Refrain::Contracts` is header-only: it exposes
# include/refrain as well as the generated C ABI / C++ contract headers
# (`<refrain/contracts/...>`). Consumers only need a C++26 compiler.

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/RefrainContractsTargets.cmake")

check_required_components(Refrain)
