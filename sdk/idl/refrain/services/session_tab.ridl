//
// Optional dynamic tab-list provider. The session calls every active instance
// in deterministic order and uses the first handled view.

module refrain::services::session_tab;
version 1.0.0;

import refrain::core;

struct tab_request {
    u64 connection;
    string player_name;
}

struct tab_view {
    string header;
    string footer;
}

service session_tab : 1.0.0 {
    side = server;
    thread = worker;
    composition = instanced;
    provides = [ "refrain:session.tab" ];
    requires = [ "refrain:core>=1.0.0" ];
    capabilities = [ "dynamic-tab" ];

    /// Return true when this provider handled the player. Strings are
    /// borrowed until the next call on this provider instance.
    #[thread(worker)]
    fn tab(in tab_request request, out tab_view view) -> bool;
}
