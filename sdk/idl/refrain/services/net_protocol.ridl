//
// `refrain:net.protocol` service contract. A provider describes its game
// family, edition and accepted protocol versions, then decodes/encodes packets
// for one transport connection. Edition is data, not a separate service key.
// The `tab_codec` extension point is an optional provider capability queried
// through the service vtable.

module refrain::services::net_protocol;
version 1.0.0;

import refrain::core;

enum protocol_edition : u32 {
    java = 0,
    bedrock = 1,
    refrain = 2,
    custom = 3,
}

enum protocol_error : u32 {
    frame_too_large = 1,
    malformed_packet = 2,
    unknown_packet = 3,
    unsupported_version = 4,
    compression_failed = 5,
}

enum protocol_event : u32 {
    status_request = 0,
    login_request = 1,
    login_acknowledged = 2,
    configuration_acknowledged = 3,
}

enum connection_state : u32 {
    handshake = 0,
    status = 1,
    login = 2,
    configuration = 3,
    play = 4,
}

/// Provider identity and transport requirements. `transport_protocol` mirrors
/// the transport service values (tcp=0, tls_tcp=1, raknet=2, ...).
struct protocol_descriptor {
    protocol_edition edition;
    string family;
    u32 canonical_version;
    string accepted_versions;
    u32 transport_protocol;
    bool requires_stream;
    string capabilities;
}

struct frame_chunk {
    /// Borrowed framed bytes, valid until the next call.
    bytes data;
}

struct decoded_packet {
    frame_header header;
    packet_view packet;
}

struct protocol_version {
    u32 protocol;
    string name;
}

struct frame_header {
    u32 length;
    u32 uncompressed_length;
}

/// Borrowed packet payload; valid for the duration of the contract call.
struct packet_view {
    u32 packet_id;
    bytes payload;
}

struct encoded_packet {
    /// Borrowed encoded packet body (packet id included).
    bytes data;
}

/// Optional tab-list packet encoder. A protocol provider that exposes this
/// extension owns the version-specific text-component encoding.
extension tab_codec : 1.0.0 {
    extends = "refrain:net.protocol";
    capability = "tab-codec";

    #[thread(worker)] #[can_fail]
    fn encode_tab(in string header, in string footer, out encoded_packet packet)
        -> result<void, protocol_error>;
}

service net_protocol : 2.0.0 {
    side = server;
    thread = net;
    composition = instanced;
    provides = [ "refrain:net.protocol" ];
    requires = [ "refrain:core>=1.0.0" ];
    capabilities = [ "frame-compression", "registry-sync" ];
    extensions = [ tab_codec ];

    #[thread(any)]
    fn descriptor(out protocol_descriptor value);

    /// Protocol number implemented by this provider (777 for vanilla 26.3).
    #[thread(any)]
    fn protocol_id() -> u32;

    #[thread(any)]
    fn accepts_version(u32 protocol) -> bool;

    /// Create/close the framing, compression and cipher state for one
    /// connection. `next_packet`/`send_packet` operate on this state.
    #[thread(any)]
    fn create_connection(u64 connection);

    #[thread(any)]
    fn close_connection(u64 connection);

    #[thread(any)] #[can_fail]
    fn set_compression(u64 connection, i32 threshold)
        -> result<void, protocol_error>;

    #[thread(any)] #[can_fail]
    fn set_cipher(u64 connection, in bytes key, in bytes iv)
        -> result<void, protocol_error>;

    /// Feed inbound transport bytes. They are decrypted and framed lazily by
    /// next_packet.
    #[thread(worker)] #[can_fail]
    fn feed(u64 connection, in bytes data)
        -> result<void, protocol_error>;

    /// Decode one packet from a connection's inbound buffer. Returns false
    /// when more transport bytes are needed.
    #[thread(worker)] #[can_fail]
    fn next_packet(u64 connection, out decoded_packet packet)
        -> result<bool, protocol_error>;

    /// Encode and enqueue one packet on the connection.
    #[thread(sim)] #[can_fail]
    fn send_packet(u64 connection, in packet_view packet)
        -> result<void, protocol_error>;

    /// Pop one framed/encrypted outbound chunk. `data` is borrowed until the
    /// next take_outbound call on that connection.
    #[thread(sim)]
    fn take_outbound(u64 connection, out frame_chunk chunk) -> bool;

    /// Report a state transition observed by the session shell. The provider
    /// keeps the state for `state_of`; it does not drive transitions.
    #[thread(net)]
    fn notify_state(u64 connection, connection_state state);

    /// Advance the connection state machine for one protocol event. The
    /// provider returns the next state and records it for `state_of`.
    #[thread(net)]
    fn transition(u64 connection, protocol_event event) -> connection_state;

    #[thread(sim)]
    fn state_of(connection conn) -> connection_state;
}
