//
// `refrain:sim` service contract v0.
//
// The simulation is a single thread per process, so the contract is a
// singleton:
// one provider owns a table of open worlds addressed by opaque handles. Tick
// order and RNG are provider-internal; the contract exposes the lifecycle, the
// monotonic tick counter, a deterministic state hash for replay checks and the
// block/entity mutations a mod may perform. Every applied mutation is also
// published as an event, so a subscriber observes the same state the provider
// committed.

module refrain::services::sim;
version 1.0.0;

import refrain::core;
import refrain::services::storage;

handle<sim_world>;

enum sim_error : u32 {
    invalid_handle = 1,
    already_open = 2,
    not_found = 3,
    io_error = 4,
    internal = 5,
    out_of_bounds = 6,
    invalid_argument = 7,
    storage_unavailable = 8,
}

struct sim_config {
    /// The store the sim persists through. The runtime opened it once from the
    /// level directory and passes the same handle to every provider of the
    /// composition; the provider never opens the directory itself.
    storage_handle storage;
    /// World seed; providers use it for their deterministic RNG stream.
    i64 seed;
}

/// Published once per tick, after the player/RNG step.
event tick_event {
    i64 tick;
}

/// One block mutation that changed the world, published once per applied
/// position in ascending position order.
event block_changed {
    i32 x;
    i32 y;
    i32 z;
    u32 old_state;
    u32 new_state;
}

/// An entity was added to the world.
event entity_spawned {
    /// Process-local entity id.
    u64 id;
    /// Namespaced entity type key, for example `minecraft:pig`.
    string type;
    f64 x;
    f64 y;
    f64 z;
}

/// An entity was removed from the world.
event entity_removed {
    /// Process-local entity id.
    u64 id;
}

service sim : 1.0.0 {
    side = server;
    thread = sim;
    provides = [ "refrain:sim" ];
    requires = [ "refrain:core>=1.0.0", "refrain:world>=1.0.0",
                 "refrain:storage>=1.0.0" ];
    capabilities = [ "tick", "replay", "deterministic-rng", "block-events",
                     "entity-events" ];

    /// Open a sim world over the given store. The provider never opens the
    /// level directory itself; the store was opened once by the runtime.
    #[thread(sim)] #[can_fail]
    fn open_world(in sim_config config) -> result<sim_world, sim_error>;

    #[thread(sim)] #[can_fail]
    fn close_world(sim_world world) -> result<void, sim_error>;

    /// Advance exactly one tick.
    #[thread(sim)] #[can_fail]
    fn tick(sim_world world) -> result<void, sim_error>;

    #[thread(any)]
    fn ticks(sim_world world) -> i64;

    /// Lowercase hex BLAKE3 of the deterministic replay state.
    #[thread(sim)]
    fn state_hash(sim_world world) -> string;

    /// Apply a batch of block mutations and publish one `block_changed` event
    /// per applied change. Returns the number of changes that modified the
    /// world; a change that writes the current state is skipped.
    #[thread(sim)] #[can_fail]
    fn set_blocks(sim_world world, in slice<block_change> changes)
        -> result<u32, sim_error>;

    /// Spawn an entity at the given feet position and publish
    /// `entity_spawned`. The id is allocated in ascending order.
    #[thread(sim)] #[can_fail]
    fn spawn_entity(sim_world world, string type, f64 x, f64 y, f64 z)
        -> result<u64, sim_error>;

    /// Remove one entity and publish `entity_removed`. Returns false when the
    /// id is unknown.
    #[thread(sim)]
    fn remove_entity(sim_world world, u64 id) -> bool;
}
